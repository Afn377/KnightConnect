# Copy to backend/.env and fill in as needed. Everything is optional for
# local development; the defaults use SQLite and print emails to the console.

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Neon connection string. Use the pooled endpoint (host contains "-pooler")
# in deployed environments. Leave unset to use local SQLite.
# DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/knightconnect?sslmode=require
# DATABASE_POOLED=true
# DATABASE_CONN_MAX_AGE=0

# Shared secret for the scheduled maintenance endpoint (also set in Vercel as CRON_SECRET).
# CRON_SECRET=change-me

# Cloudflare R2 for profile pictures. Leave unset to store uploads in backend/media/.
# R2_BUCKET=knightconnect-media
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_DOMAIN=pub-xxxx.r2.dev

ALLOWED_EMAIL_DOMAINS=rutgers.edu,scarletmail.rutgers.edu
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DEFAULT_FROM_EMAIL=KnightConnect <no-reply@example.com>
